# Ignore everything in the root
/*

# 1. Allow .gitignore and essential root setup files (optional)
# /.gitignore
# /README.md  # We will keep the root README but maybe hide it? 
# User said "flashnotes以外的文件不出现在 github"
# So we only unignore flashnotes.

# 2. Allow flashnotes directory
!/flashnotes/
!/flashnotes/**

# 3. Allow current .gitignore itself so the rules are tracked
!/.gitignore

# --- Rules for inside flashnotes (moved from flashnotes/.gitignore) ---
/flashnotes/node_modules
/flashnotes/.vercel
/flashnotes/.env.local
/flashnotes/.firebase
/flashnotes/firebase-debug.log
/flashnotes/dist
/flashnotes/.DS_Store
