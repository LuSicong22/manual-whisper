# 必填：Replicate API Token
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 必填：前后端共享访问密钥（用于保护 API）
# 可通过命令生成：openssl rand -hex 32
APP_SHARED_KEY=replace-with-a-strong-secret

# 可选：是否强制需要密钥才能访问（默认 false）
# ENFORCE_APP_SHARED_KEY=true

# 可选：说话人分离所需的 Hugging Face Token（如果不需要分离可留空）
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx

# 可选：专有名词词汇表（逗号分隔，帮助纠错）
# DOMAIN_TERMS=微信,支付宝,二维码,收款码,小程序,公众号,NFC,APP,H5
