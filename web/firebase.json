{
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**",
            "functions/**",
            "api/**",
            "package.json",
            "package-lock.json",
            "README.md"
        ],
        "rewrites": [
            {
                "source": "/api/**",
                "function": "api",
                "region": "asia-east1"
            }
        ]
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log"
            ]
        }
    ]
}